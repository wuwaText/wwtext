-diff --git a/3.7.7-prod/MultiText_ja.json b/3.7.8-prod/MultiText_ja.json
-index 9b3682c..5f8d434 100644
---- a/3.7.7-prod/MultiText_ja.json
-+++ b/3.7.8-prod/MultiText_ja.json
-@@ -290688,7 +290688,7 @@
-   "Skill_1006102_SkillDescribe": "<size=40><color=Title>共鳴スキル・応世の相</color></size>\n<color=Highlight>応世の相</color>中、<color=Highlight>共鳴スキル</color>を一回押しすると、<color=Thunder>電導ダメージ</color>を与える。\nこのスキルを発動した直後に<color=Highlight>通常攻撃</color>を一回押しすると、<color=Highlight>通常攻撃・応世の相4段目</color>を発動する。\n空中でも発動可能。\n\nこのスキルを発動後、一定時間内に心が地面で移動すると、<color=Highlight>心狐</color>の姿になる。\n· <color=Highlight>心狐</color>の姿になった時、戦闘離脱状態の場合<color=Highlight>塵ひとつ乱さず</color>を獲得する。<color=Highlight>塵ひとつ乱さず</color>を所持している間、心は目標の警戒範囲に入っても戦闘状態に入らない。心が戦闘に入った時、他のキャラに切り替えた時、または心がフィールド・コンテンツ・機能とのインタラクトによって<color=Highlight>心狐</color>形態が解除された時、<color=Highlight>塵ひとつ乱さず</color>は強制的に解除される。\n· <color=Highlight>心狐</color>の姿でいる間、戦闘離脱状態の場合、{1}秒ごとにHP上限{0}分のHPを回復する。\n· <color=Highlight>心狐</color>の姿でいる間、心がダメージを受けた時、地面で方向キーを入力せずに<color=Highlight>回避</color>した時、または空中で<color=Highlight>回避</color>した時、<color=Highlight>心狐</color>形態は解除される。他のキャラに切り替えるか、<color=Highlight>共鳴スキル</color>を一回押ししても<color=Highlight>心狐</color>形態は解除される。<color=Highlight>通常攻撃</color>を一回押しすると、<color=Highlight>心狐</color>形態を解除し、<color=Highlight>通常攻撃・応世の相4段目</color>を発動する。\n· <color=Highlight>心狐</color>の姿でいる間、心がダッシュ状態になると、スタミナを継続的に消費する。\n· <color=Highlight>心狐</color>の姿でいる間、心は<color=Highlight>共鳴解放</color>を発動できない。\n\n<size=40><color=Title>共鳴スキル・照世の相</color></size>\n<color=Highlight>照世の相</color>中、心が地面にいる状態で<color=Highlight>共鳴スキル</color>を一回押しすると、心は巨大な玄方機巧を操り、<color=Thunder>電導ダメージ</color>を与える。",
