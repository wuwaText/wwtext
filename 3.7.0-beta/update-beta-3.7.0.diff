+  "DangoBrawlTalk_aimisi_01": "Hope I won't let you down.",
+  "DangoBrawlTalk_aimisi_02": "It's showtime!",
+  "DangoBrawlTalk_aimisi_03": "Please welcome—Fleet Snowfluff!",
+  "DangoBrawlTalk_aimisi_04": "Wanna join me?",
+  "DangoBrawlTalk_aimisi_05": "Hello, there!",
+  "DangoBrawlTalk_feibi_01": "I'll do my best.",
+  "DangoBrawlTalk_feibi_02": "Maybe we can... talk this out?",
