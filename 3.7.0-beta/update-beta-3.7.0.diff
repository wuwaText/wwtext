@@ -194613,12 +195722,12 @@
   "MonsterInfo_320000560_DiscoveredDes": "ศัตรูนี้มี<color=HighlightB>ความต้านทาน</color>ต่อ<color=Dark>ความเสียหายฮาวอค</color>เพิ่มขึ้น\nSabercat Prowler ในสถานะล่องหน จะมีความต้านทานค่าสถานะทั้งหมดเพิ่มขึ้น 30%\nSabercat Prowler หลังจากถูกโจมตีด้วยการทำลายเสียงประสาน จะออกจากสถานะล่องหน\nเมื่อ Sabercat Prowler อยู่ในสถานะเสียงสั่นสะเทือน: เบี่ยงเบน และถูกโจมตีด้วยการทำลายเสียงประสาน จะได้รับความเสียหายเพิ่มเติม 25% ของ HP สูงสุดของมันเอง โดยเอฟเฟกต์นี้สามารถเปิดใช้งานได้เพียงครั้งเดียวเท่านั้น\nเครื่องจักรที่สามารถซ่อนร่างกายได้ เนื่องจากชิ้นส่วนกลไกของมันได้รับการรบกวนจากสสารสุญตา ทำให้การมองเห็นและการได้ยินเสื่อมถอยลงอย่างรุนแรง แต่ก็ให้ความรู้สึกที่เฉียบคมกว่า มันสามารถพึ่งพาอุปกรณ์ตรวจจับที่หางเพื่อรับรู้การเปลี่ยนแปลงความถี่ จึงสามารถติดตามร่องรอยของศัตรูได้",
   "MonsterInfo_320000560_Name": "Sabercat Prowler",
