   "LyricsText_800008_Original": "<i>孤身入人烟</i>",
@@ -165346,15 +166276,97 @@
   "LyricsText_800009_Original": "<i>悯 芸芸众生有情念</i>",
   "LyricsText_800009_Translation": "<i>My heart aches, as all hearts ache</i>",
