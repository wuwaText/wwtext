-  "RoleTowerStarDesc_4_2": "เมื่ออยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> <color=Highlight>วงจรฟอร์เต้ - ดอกไม้ชั่ววัน</color>จะสามารถสร้างความเสียหายหลายครั้งและทำให้การโจมตีถัดไปสร้างความเสียหายเพิ่มเติม\nเมื่อไม่ได้อยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> ความเสียหายสุดท้ายของ<color=Highlight>วงจรฟอร์เต้ - ดอกไม้ชั่ววัน</color>จะเพิ่มขึ้น",
+  "RoleTowerStarDesc_4_2": "เมื่ออยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> <color=Highlight>วงจรฟอร์เต้ - ดอกไม้ชั่ววัน</color>และ<color=Highlight>วงจรฟอร์เต้ - บุปผานิรันดร์</color>จะสามารถสร้างความเสียหายหลายครั้งและทำให้การโจมตีถัดไปสร้างความเสียหายเพิ่มเติม\nเมื่อไม่ได้อยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> ความเสียหายสุดท้ายของ<color=Highlight>วงจรฟอร์เต้ - ดอกไม้ชั่ววัน</color>และ<color=Highlight>วงจรฟอร์เต้ - บุปผานิรันดร์</color>จะเพิ่มขึ้น",
   "RoleTowerStarDesc_4_3": "เมื่ออยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> ความเสียหายสุดท้ายของ<color=Highlight>โจมตีปกติ</color>จะเพิ่มขึ้น\nเมื่อไม่ได้อยู่ในสถานะ<color=Highlight>บุปผาเบ่งบาน</color> ความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - บุปผารวมชีวา</color>จะเพิ่มขึ้น",
   "RoleTowerStarDesc_5_1": "ความเสียหายสุดท้ายที่ Carlotta สร้างเพิ่มขึ้น\nเมื่อไม่ได้อยู่ในสถานะเสริมพลังของการ<color=Highlight>ปลดปล่อยเรโซแนนซ์</color> เมื่อ Carlotta ใช้<color=Highlight>สกิลอินโทร</color> จะฟื้นฟู [<color=Highlight>สสาร</color>] จนเต็ม\nเมื่ออยู่ในสถานะเสริมพลังของการ<color=Highlight>ปลดปล่อยเรโซแนนซ์</color> จะได้รับเอฟเฟกต์ดังต่อไปนี้:\n- <color=Highlight>ลางมรณะ</color>จะสร้างความเสียหายเพิ่มเติมและลดค่าสั่นสะเทือนเพิ่มเติม อีกทั้งยังทำให้ความเสียหายสุดท้ายของการ<color=Highlight>ปลดปล่อยเรโซแนนซ์ - ปิดท้ายมรณา</color>เพิ่มขึ้น และจะเพิ่มขึ้นมากยิ่งขึ้นเมื่อโจมตีเป้าหมายในสถานะอัมพาต\n- เมื่อใช้<color=Highlight>สกิลเรโซแนนซ์</color> จะรีเซ็ตจำนวนครั้งที่สามารถใช้<color=Highlight>ลางมรณะ</color>ได้\n- เมื่อ<color=Highlight>เกจฟอร์เต้</color>เต็ม จะสามารถรีเฟรชคูลดาวน์ของ<color=Highlight>สกิลเรโซแนนซ์</color>ได้",
-  "RoleTowerStarDesc_5_2": "เมื่อใช้<color=Highlight>โจมตีหนัก - ธาตุแท้ที่ปลายทาง</color>หรือ<color=Highlight>โจมตีหนัก - กลยุทธ์ควบคุม</color> Carlotta จะได้รับ<color=Highlight>ผลึกกระจกหลากสี</color> โดย<color=Highlight>ผลึกกระจกหลากสี</color>จะทำให้ความเสียหายสุดท้ายที่ Carlotta สร้างเพิ่มขึ้น",
+  "RoleTowerStarDesc_5_2": "เมื่อใช้<color=Highlight>โจมตีหนัก - ธาตุแท้ที่ปลายทาง</color>หรือ<color=Highlight>โจมตีหนัก - กลยุทธ์ควบคุม</color> Carlotta จะได้รับ<color=Highlight>ปริซึมหลากสี</color> โดย<color=Highlight>ปริซึมหลากสี</color>จะทำให้ความเสียหายสุดท้ายที่ Carlotta สร้างเพิ่มขึ้น",
   "RoleTowerStarDesc_5_3": "ความเสียหายสุดท้ายของ<color=Highlight>โจมตีหนัก - ธาตุแท้ที่ปลายทาง</color>, <color=Highlight>โจมตีหนัก - กลยุทธ์ควบคุม</color> และ<color=Highlight>ลางมรณะ</color>เพิ่มขึ้น",
-  "RoleTowerStarDetailDesc_1_1": "ความเสียหายสุดท้ายที่ Xiangli Yao สร้างเพิ่มขึ้น {0}\n<size=10></size>\nเมื่อ Xiangli Yao ใช้<color=Highlight>สกิลอินโทร</color> จะได้รับ [<color=Highlight>พลังประมวลผล</color>] {1} หน่วย\nความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - ถอดรหัส</color>และ<color=Highlight>โจมตีกลางอากาศ - แยกประกอบใหม่</color>เพิ่มขึ้น {2} หลังจากใช้<color=Highlight>สกิลเรโซแนนซ์ - ถอดรหัส</color>แล้ว การใช้<color=Highlight>โจมตีกลางอากาศ - แยกประกอบใหม่</color>จะถือว่าเป็นการใช้<color=Highlight>ปลดปล่อยเรโซแนนซ์ - แบบจำลองความคิด</color> และสามารถเข้าสู่สถานะ<color=Highlight>การหยั่งรู้</color>ได้โดยตรง พร้อมทั้งได้รับ<color=Highlight>ไฮเปอร์คิวบ์</color> {3} หน่วย และ [<color=Highlight>พลังประมวลผลขั้นสูง</color>] {4} หน่วย\nเมื่อ<color=Highlight>ปลดปล่อยเรโซแนนซ์ - แบบจำลองความคิด</color> จะไม่เข้าสู่สถานะ<color=Highlight>การหยั่งรู้</color>อีกต่อไป\nหลังจากใช้สกิลเอาท์โทร - กฎลูกโซ่แล้ว จะออกจากสถานะ<color=Highlight>การหยั่งรู้</color>\n<size=10></size>\nขณะอยู่ในสถานะ<color=Highlight>การหยั่งรู้</color> จะได้รับการเสริมพลังต่อไปนี้:\n- หาก [<color=Highlight>พลังประมวลผลขั้นสูง</color>] ไม่เท่ากับ {5} เมื่อ<color=Highlight>กดค้างโจมตีปกติ</color>จะสามารถใช้ [<color=Highlight>พลังประมวลผลขั้นสูง</color>] {6} หน่วยเพื่อใช้<color=Highlight>โจมตีหนัก - ชาร์จยิงทะลวง</color> สร้าง<color=Thunder>ความเสียหายอิเล็กโทร</color> {7} ของตัวคูณ<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>ปลดปล่อยเรโซแนนซ์</color>\n- <color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color>สามารถดึงดูดมอนสเตอร์ที่อยู่ใกล้เคียงได้\n- ระยะเคลื่อนที่ของ<color=Highlight>สกิลเรโซแนนซ์ - หนึ่งรากแตกแขนง</color>และ<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color>จะไกลขึ้น",
+  "RoleTowerStarDetailDesc_1_1": "ความเสียหายสุดท้ายที่ Xiangli Yao สร้างเพิ่มขึ้น {0}\n<size=10></size>\nเมื่อ Xiangli Yao ใช้<color=Highlight>สกิลอินโทร</color> จะได้รับ [<color=Highlight>พลังประมวลผล</color>] {1} หน่วย\nความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - ถอดรหัส</color>และ<color=Highlight>โจมตีกลางอากาศ - แยกประกอบใหม่</color>เพิ่มขึ้น {2} หลังจากใช้<color=Highlight>สกิลเรโซแนนซ์ - ถอดรหัส</color>แล้ว การใช้<color=Highlight>โจมตีกลางอากาศ - แยกประกอบใหม่</color>จะถือว่าเป็นการใช้<color=Highlight>ปลดปล่อยเรโซแนนซ์ - แบบจำลองความคิด</color> และสามารถเข้าสู่สถานะ<color=Highlight>การหยั่งรู้</color>ได้โดยตรง พร้อมทั้งได้รับ<color=Highlight>ไฮเปอร์คิวบ์</color> {3} หน่วย และ [<color=Highlight>พลังประมวลผลขั้นสูง</color>] {4} หน่วย\nเมื่อ<color=Highlight>ปลดปล่อยเรโซแนนซ์ - แบบจำลองความคิด</color> จะไม่เข้าสู่สถานะ<color=Highlight>การหยั่งรู้</color>อีกต่อไป\nหลังจากใช้สกิลเอาท์โทร - กฎลูกโซ่แล้ว จะออกจากสถานะ<color=Highlight>การหยั่งรู้</color>\n<size=10></size>\nขณะอยู่ในสถานะ<color=Highlight>การหยั่งรู้</color> จะได้รับการเสริมพลังต่อไปนี้:\n- หาก [<color=Highlight>พลังประมวลผลขั้นสูง</color>] ไม่เท่ากับ {5} เมื่อ<color=Highlight>กดค้างโจมตีปกติ</color>จะสามารถใช้ [<color=Highlight>พลังประมวลผลขั้นสูง</color>] {6} หน่วยเพื่อใช้<color=Highlight>โจมตีหนัก - ชาร์จยิงทะลวง</color> ฟื้นฟูพลังงานคอนแชร์โต {7} หน่วย และสร้าง<color=Thunder>ความเสียหายอิเล็กโทร</color> {8} ของตัวคูณ<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>ปลดปล่อยเรโซแนนซ์</color>\n- <color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color>สามารถดึงดูดมอนสเตอร์ที่อยู่ใกล้เคียงได้\n- ระยะเคลื่อนที่ของ<color=Highlight>สกิลเรโซแนนซ์ - หนึ่งรากแตกแขนง</color>และ<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color>จะไกลขึ้น",
   "RoleTowerStarDetailDesc_1_2": "เมื่อ<color=Highlight>ปลดปล่อยเรโซแนนซ์</color> ความเสียหายสุดท้ายที่ Xiangli Yao สร้างจะเพิ่มขึ้น {0} เป็นเวลา {1} วินาที",
   "RoleTowerStarDetailDesc_1_3": "ความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color>, <color=Highlight>โจมตีหนัก - ชาร์จยิงทะลวง</color> และเมทริกซ์แตกแขนงเพิ่มขึ้น {0}\nเมื่อ Xiangli Yao ใช้<color=Highlight>สกิลเรโซแนนซ์ - กฎแห่งการปกครอง</color> จะได้รับ [<color=Highlight>การวิเคราะห์เต็มรูปแบบ</color>] {1} ชั้น ซ้อนทับได้สูงสุด {2} ชั้น\n[<color=Highlight>การวิเคราะห์เต็มรูปแบบ</color>] มีขีดจำกัดสูงสุด {3} ชั้น เมื่อได้รับความเสียหายจากการโจมตีของศัตรู จะสามารถใช้ [<color=Highlight>การวิเคราะห์เต็มรูปแบบ</color>] {4} ชั้น เพื่อทำให้ตนเองต้านทานการขัดจังหวะ และลดความเสียหายที่ได้รับลง {5} เป็นเวลา {6} วินาที เอฟเฟกต์นี้สามารถเปิดใช้งานได้ 1 ครั้งทุกวินาที",
-  "RoleTowerStarDetailDesc_2_1": "ความเสียหายสุดท้ายที่ Jinhsi สร้างเพิ่มขึ้น {0}\n<size=10></size>\nหาก Jinhsi อยู่ในสถานะ<color=Highlight>คว้ากาลสู่เวหา</color>และมี [<color=Highlight>ลุกโชติช่วง</color>] ไม่ต่ำกว่า {1} หน่วย เมื่อ<color=Highlight>กดค้างโจมตีปกติ</color> จะสามารถใช้<color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color>และ<color=Highlight>โจมตีหนัก - มังกรดิ่งลึก</color>อย่างต่อเนื่องได้\n- <color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color>จะสร้างความเสียหาย {2} ของตัวคูณ<color=Highlight>สู่เวหา: โจมตีปกติช่วงที่ 3 </color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color> เมื่อใช้<color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color> จะใช้ [<color=Highlight>ลุกโชติช่วง</color>] {3} หน่วย และสร้าง [<color=Highlight>อัสนีบาตฟาด</color>] {4} สาย และ [<color=Highlight>กาลสั่นสะเทือน</color>] {5} สายในบริเวณใกล้เคียง\n- <color=Highlight>โจมตีหนัก - มังกรดิ่งลึก</color>จะสร้างความเสียหาย {6} ของตัวคูณ<color=Highlight>สู่เวหา: โจมตีปกติช่วงที่ 4</color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color> เมื่อใช้<color=Highlight>โจมตีหนัก - มังกรดิ่งลึก</color> จะใช้ [<color=Highlight>ลุกโชติช่วง</color>] {7} หน่วย และสร้าง [<color=Highlight>อัสนีบาตฟาด</color>] {8} สาย และ [<color=Highlight>กาลสั่นสะเทือน</color>] {9} สายในบริเวณใกล้เคียง\n[<color=Highlight>อัสนีบาตฟาด</color>] แต่ละสายจะสร้าง<color=Light>ความเสียหายสเปกโตร</color> {10} ของ ATK ของ Jinhsi และ [<color=Highlight>กาลสั่นสะเทือน</color>] แต่ละสายจะสร้าง<color=Light>ความเสียหายสเปกโตร</color> {11} ของ ATK ของ Jinhsi โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color>\nความเสียหายที่สร้างโดย [<color=Highlight>อัสนีบาตฟาด</color>] และ [<color=Highlight>กาลสั่นสะเทือน</color>] จะได้รับผลจากเอฟเฟกต์เพิ่มตัวคูณเมื่อใช้ [<color=Highlight>ลุกโชติช่วง</color>] ของห่วงโซ่เรโซแนนซ์ Jinhsi \"สิ้นหนาวสู่วสันต์\"\nระยะเคลื่อนที่ของ<color=Highlight>สกิลเรโซแนนซ์ - เทวะจันทร์เสี้ยว</color>เพิ่มขึ้น\n<size=10></size>\nเมื่อเรโซเนเตอร์ในทีมกำจัดเป้าหมายศัตรู Jinhsi จะได้รับ<color=Highlight>กาลเวลาผันผ่าน</color> {12} ชั้น ซ้อนทับได้สูงสุด {13} ชั้น\nเมื่อใช้<color=Highlight>สกิลเรโซแนนซ์ - เทวะจันทร์เสี้ยว</color> จะลบ<color=Highlight>กาลผันผ่าน</color>ทั้งหมด โดยทุก {14} ชั้นที่ลบไปจะทำให้ความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - เทวะจันทร์เสี้ยว</color>ในครั้งนี้เพิ่มขึ้น {15} และฟื้นฟู [<color=Highlight>ลุกโชติช่วง</color>] {16} หน่วย ซึ่งเพิ่มได้สูงสุด {17} และฟื้นฟู [<color=Highlight>ลุกโชติช่วง</color>] {18} หน่วย",
+  "RoleTowerStarDetailDesc_2_1": "ความเสียหายสุดท้ายที่ Jinhsi สร้างเพิ่มขึ้น {0}\n<size=10></size>\nความเสียหายสุดท้ายของ<color=Highlight>สกิลเรโซแนนซ์ - สำแดงส่องประกาย</color>เพิ่มขึ้น {1}\nหาก Jinhsi อยู่ในสถานะ<color=Highlight>คว้ากาลสู่เวหา</color>และมี [<color=Highlight>ลุกโชติช่วง</color>] ไม่ต่ำกว่า {2} หน่วย เมื่อ<color=Highlight>กดค้างโจมตีปกติ</color> จะสามารถใช้<color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color>และ<color=Highlight>โจมตีหนัก - มังกรดิ่งสู่ห้วงลึก</color>อย่างต่อเนื่องได้\n- <color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color>จะสร้างความเสียหาย {3} ของตัวคูณ<color=Highlight>สู่เวหา: โจมตีปกติช่วงที่ 3 </color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color> เมื่อใช้<color=Highlight>โจมตีหนัก - มังกรเหินเวหา</color> จะใช้ [<color=Highlight>ลุกโชติช่วง</color>] {4} หน่วย และสร้าง [<color=Highlight>อัสนีบาตฟาดโจมตี</color>] {5} สาย และ [<color=Highlight>กาลเวลาสั่นสะเทือน</color>] {6} สายในบริเวณใกล้เคียง\n- <color=Highlight>โจมตีหนัก - มังกรดิ่งสู่ห้วงลึก</color>จะสร้างความเสียหาย {7} ของตัวคูณ<color=Highlight>สู่เวหา: โจมตีปกติช่วงที่ 4</color> โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color> เมื่อใช้<color=Highlight>โจมตีหนัก - มังกรดิ่งสู่ห้วงลึก</color> จะใช้ [<color=Highlight>ลุกโชติช่วง</color>] {8} หน่วย และสร้าง [<color=Highlight>อัสนีบาตฟาดโจมตี</color>] {9} สาย และ [<color=Highlight>กาลเวลาสั่นสะเทือน</color>] {10} สายในบริเวณใกล้เคียง\n[<color=Highlight>อัสนีบาตฟาดโจมตี</color>] แต่ละสายจะสร้าง<color=Light>ความเสียหายสเปกโตร</color> {11} ของ ATK ของ Jinhsi และ [<color=Highlight>กาลเวลาสั่นสะเทือน</color>] แต่ละสายจะสร้าง<color=Light>ความเสียหายสเปกโตร</color> {12} ของ ATK ของ Jinhsi โดยความเสียหายนี้จะนับเป็นความเสียหาย<color=Highlight>สกิลเรโซแนนซ์</color>\nความเสียหายที่สร้างโดย [<color=Highlight>อัสนีบาตฟาดโจมตี</color>] และ [<color=Highlight>กาลเวลาสั่นสะเทือน</color>] จะได้รับผลจากเอฟเฟกต์เพิ่มตัวคูณเมื่อใช้ [<color=Highlight>ลุกโชติช่วง</color>] ของห่วงโซ่เรโซแนนซ์ Jinhsi