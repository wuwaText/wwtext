diff --git a/3.7.18-prod/MultiText_zh-Hans.json b/3.8.6-prod/MultiText_zh-Hans.json
index 280f7e6..96df98f 100644
--- a/3.7.18-prod/MultiText_zh-Hans.json
+++ b/3.8.6-prod/MultiText_zh-Hans.json
@@ -939,6 +939,399 @@
   "35TUOZUI_9_7": "甚至有人请求军策府暂停机傀生产，收容所有运行中机体统一销毁……",
   "35TUOZUI_9_8": "伪君子，假清高！我早就看他不顺眼了！",
   "35TUOZUI_9_9": "所以，你了解他具体做了什么吗？",
+  "ACTION_AVGspecial_1000_1": "嗯，艺术考试的复习题目是……",
+  "ACTION_AVGspecial_1000_2": "同一主题可以通过绘画、音乐、舞蹈等不同形式表现。这说明——",
+  "ACTION_AVGspecial_1000_3": "艺术形式虽然不同，但都可以<u>表达和传递情感与思想</u>。",
+  "ACTION_AVGspecial_1000_4": "是呀，也许表现手法和创作规则各不相同，但艺术想要传递的情感，却能够跨越这些差异，抵达每个人心里。",
+  "ACTION_AVGspecial_1000_5": "这就是艺术的魅力所在吧。",
+  "ACTION_AVGspecial_100_1": "来到教室，在贴着自己学号的课桌前坐了下来。",
+  "ACTION_AVGspecial_100_2": "教室里比往常安静许多，只剩下翻动复习资料和整理文具的细碎声响。",
+  "ACTION_AVGspecial_100_3": "进入考场前，长离对你说过的话，此刻依然萦绕在耳边。",
+  "ACTION_AVGspecial_100_4": "加油，{PlayerName}。",
+  "ACTION_AVGspecial_100_5": "请各位同学认真核对考试科目和试卷页数，并填写姓名与考号。正式开考前请不要翻阅试题哦。",
+  "ACTION_AVGspecial_100_6": "（这段时间的努力，终于到了要接受检验的时候。）",
+  "ACTION_AVGspecial_100_7": "随着考试开始的铃声响起，你深吸一口气，翻开了面前的试卷。",
+  "ACTION_AVGspecial_10_1": "推开商店的店门时，柜台之后依然空空如也，只有一阵窸窸窣窣的声音从货架另一边传来。",
+  "ACTION_AVGspecial_10_10": "虽然你今天的本意就是来商店兼职，但看到洛可可这副认真的模样，你还是忍不住半开玩笑地问道：",
+  "ACTION_AVGspecial_10_11": "可以是可以，不过……有工资吗？",
+  "ACTION_AVGspecial_10_12": "那当然。学院商店和洛可可都从不拖欠员工薪水。",
+  "ACTION_AVGspecial_10_13": "洛可可一本正经地叉着腰，满脸认真地向你点了点头。",
+  "ACTION_AVGspecial_10_14": "事不宜迟，今天就开始工作吧，{PlayerName}。",
+  "ACTION_AVGspecial_10_2": "但不知为何，你似乎已经完全习惯了这样的场景，熟门熟路地绕到了柜台后面。",
+  "ACTION_AVGspecial_10_3": "果不其然，商店的店长——洛可可，正踩在小梯子上，踮着脚把一箱刚到的商品一件件摆上货架。她抱着一摞小盒子，刚准备转身，却发现已经没有空着的手去拿旁边那一箱了。",
+  "ACTION_AVGspecial_10_4": "眼看着这位身形小巧的女孩子又要踩着梯子上上下下地搬东西，你索性顺手把柜台上的纸箱抱了起来，走过去递到了洛可可的手边。",
+  "ACTION_AVGspecial_10_5": "谢谢，放在旁边就好。",
+  "ACTION_AVGspecial_10_6": "……嗯？",
+  "ACTION_AVGspecial_10_7": "洛可可的动作忽然顿了两秒，回过头来。",
+  "ACTION_AVGspecial_10_8": "咦，我还以为是理货员呢……原来是{PlayerName}。",
+  "ACTION_AVGspecial_10_9": "既然如此，{PlayerName}要不要干脆来帮帮洛可可？整理货架、盘点库存、收银结账，都可以。",
+  "ACTION_AVGspecial_1100_1": "交响乐团中的弦乐组，是乐团规模最大、通常也是演奏人数最多的声部组。",
+  "ACTION_AVGspecial_1100_2": "弦乐器主要通过琴弦振动发声，包括提琴、竖琴，曼陀林琴，维奥尔琴等等……",
+  "ACTION_AVGspecial_1100_3": "其中，音域最低的乐器是，<u>低音提琴</u>。",
+  "ACTION_AVGspecial_1100_4": "啊，我想起来了！第一次听见管弦乐社的合奏时，就是{PlayerName}向我介绍的<u>低音提琴</u>呢。",
+  "ACTION_AVGspecial_110_1": "铃声响起，在最后一刻放下了手中的笔。",
+  "ACTION_AVGspecial_110_2": "考试已经结束，请各位同学立即停止作答。并将试卷按照顺序摆放在桌面，等老师清点完毕之后再有序离开考场。",
+  "ACTION_AVGspecial_110_3": "（检定考试的模拟考，算是全部结束了。不知道大家发挥得怎么样……）",
+  "ACTION_AVGspecial_110_4": "尽管结果尚未可知，但，至少这场属于你们的战斗已经暂时告一段落了。",
+  "ACTION_AVGspecial_110_5": "各位都已经拼尽全力走到了最后，接下来，就先好好休息一下吧。",
+  "ACTION_AVGspecial_110_6": "大家都已经为这次考试好好努力过了，不用太过在意一时的成绩得失。",
+  "ACTION_AVGspecial_110_7": "无论这次发挥得好还是不好，都可以把结果当作一次参考，根据实际情况调整接下来的学习方向。",
+  "ACTION_AVGspecial_110_8": "和大家一起离开了考场。",
+  "ACTION_AVGspecial_1200_1": "素描中的<u>明暗关系</u>，指的是物体在光线照射下，由于受光程度不同而形成的亮部、暗部以及它们之间的过渡关系。",
+  "ACTION_AVGspecial_1200_2": "它是表现<u>物体的体积、空间感和质感</u>的重要基础。",
+  "ACTION_AVGspecial_1200_3": "嗯？卡提希娅，你在说什么呢？",
+  "ACTION_AVGspecial_1200_4": "在复习艺术考试的基础知识啦……",
+  "ACTION_AVGspecial_1200_5": "在素描绘画中，想要表现物体的<u>立体感</u>，主要依靠的是<u>明暗关系</u>。",
+  "ACTION_AVGspecial_1200_6": "和画纸尺寸，铅笔品牌之类的都没有关系。",
+  "ACTION_AVGspecial_120_1": "预选赛会场的后台，管弦乐社的众人正为即将开始的团体赛做最后准备。",
+  "ACTION_AVGspecial_120_2": "呼……虽然有点紧张，但是感觉今天的状态还算不错。",
+  "ACTION_AVGspecial_120_3": "没事啦没事啦，各位之前都练习了那么久，小小预选赛，一定没问题的。",
+  "ACTION_AVGspecial_120_4": "嗯！一起加油吧！",
+  "ACTION_AVGspecial_120_5": "（为了方便评委横向比较，预选赛要求所有队伍演奏指定曲目。）",
+  "ACTION_AVGspecial_120_6": "（看样子，上一支队伍……应该马上就要结束了。）",
+  "ACTION_AVGspecial_120_7": "各位，要准备登台了。",
+  "ACTION_AVGspecial_1300_1": "今天我们讲解人文社科与历史知识。",
+  "ACTION_AVGspecial_1300_2": "历史事实具有客观性，不会因为个人的喜好、立场或解释而改变。",
