+  "Main_Mengzhou_3_7_15_18": "Ein Freund hat seinen Standort geteilt",
+  "Main_Mengzhou_3_7_15_19": "Ich werde hier auf dich warten.",
   "Main_Mengzhou_3_7_15_2": "",
